---
/* Admin panel — separate from the website, not indexed by Google */
import '@fontsource-variable/manrope';
import '@fontsource-variable/sora';
import '@fontsource-variable/urbanist';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/outfit';
import '@fontsource-variable/plus-jakarta-sans';
import '../../admin/admin.css';
import { getImage } from 'astro:assets';
import App from '../../admin/App';
import logoMark from '../../assets/brand/logo-mark.png';
import loginPhoto from '../../assets/images/hero-house.jpg';

const favicon = await getImage({ src: logoMark, width: 64, height: 64, format: 'png' });
const loginBg = await getImage({ src: loginPhoto, width: 1400, format: 'webp', quality: 72 });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" href={favicon.src} type="image/png" />
    <title>Admin Panel — Bangash Real Estate</title>
  </head>
  <body class="a-body" style={`--login-bg: url('${loginBg.src}')`}>
    <!-- Apply the saved font choice before the app renders (no flash of the wrong font) -->
    <script is:inline>
      try { document.body.dataset.font = localStorage.getItem('bangash-admin-font') || 'modern'; } catch { document.body.dataset.font = 'modern'; }
    </script>
    <App client:only="preact">
      <div class="a-center" slot="fallback"><span class="a-spinner"></span></div>
    </App>
  </body>
</html>
