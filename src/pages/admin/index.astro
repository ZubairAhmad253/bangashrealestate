---
/* Admin panel — separate from the website, not indexed by Google */
import '@fontsource-variable/manrope';
import '@fontsource-variable/sora';
import '../../admin/admin.css';
import { getImage } from 'astro:assets';
import App from '../../admin/App';
import logoMark from '../../assets/brand/logo-mark.png';
import loginPhoto from '../../assets/images/hero-house.jpg';

const favicon = await getImage({ src: logoMark, width: 64, height: 64, format: 'png' });
const loginBg = await getImage({ src: loginPhoto, width: 1400, format: 'webp', quality: 72 });
const touchIcon = await getImage({ src: logoMark, width: 180, height: 180, format: 'png' });

// Version of the admin app: a fingerprint of its source files. The installed app compares it with the
// published one to know when to update itself. Website rebuilds after a listing is saved keep the same
// version — only real changes to the admin panel make a new one.
const sources = import.meta.glob(['../../admin/**/*.{ts,tsx,css}', '../../config/*.ts', './*.astro'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
let hash = 2166136261;
for (const key of Object.keys(sources).sort()) {
  for (const text of [key, sources[key]]) {
    for (let i = 0; i < text.length; i++) hash = Math.imul(hash ^ text.charCodeAt(i), 16777619);
  }
}
const appVersion = (hash >>> 0).toString(36);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="app-version" content={appVersion} />
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" href={favicon.src} type="image/png" />
    <!-- Installable on phones: "Add to Home screen" opens the admin like an app -->
    <link rel="manifest" href="/admin/manifest.webmanifest" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Bangash Admin" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>Admin Panel — Bangash Real Estate</title>
  </head>
  <body class="a-body" style={`--login-bg: url('${loginBg.src}')`}>
    <App client:only="preact">
      <div class="a-center" slot="fallback"><span class="a-spinner"></span></div>
    </App>
  </body>
</html>
