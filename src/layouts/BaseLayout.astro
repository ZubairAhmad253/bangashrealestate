---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/outfit';
import '../styles/global.css';
import SEO, { type SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { SITE } from '../config/site';
import '../lib/remote'; // apply admin settings (phone, WhatsApp…) before rendering
import logoMark from '../assets/brand/logo-mark.png';

const favicon = await getImage({ src: logoMark, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: logoMark, width: 180, height: 180, format: 'png' });

type Props = SEOProps;
const props = Astro.props;

/* Theme: "gold" (matches the logo) or "blue" (matches the shop sign) — colors live in src/styles/theme.css */
const THEME = 'gold';
const themeColor = THEME === 'gold' ? '#0d0d0d' : '#141c55';

/* Vercel Web Analytics (cookie-free). Only added on Vercel builds; turn it on in Vercel → Project → Analytics. */
const analytics = Boolean(process.env.VERCEL);
---

<!doctype html>
<html lang="en-PK" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={favicon.src} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
    <!-- Animations only run with JavaScript; without JS all content stays visible -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO {...props} />
    {
      SITE.ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
          <script is:inline define:vars={{ id: SITE.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', id);
          </script>
        </>
      )
    }
    {
      analytics && (
        <>
          <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
          <script is:inline defer src="/_vercel/insights/script.js"></script>
        </>
      )
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
