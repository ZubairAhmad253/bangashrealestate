---
/* Signboard wala logo (buildings + chhat + khirki) — SVG mein taake har size par sharp rahe. */
import { SITE } from '../config/site';
interface Props { id?: string }
const { id = 'logo' } = Astro.props;
const gid = `${id}-grad`;
---

<a href="/" class="logo" aria-label={`${SITE.name} — Home`}>
  <svg class="logo__mark logo__mark--sign" viewBox="0 0 60 52" aria-hidden="true">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--brand-secondary)" />
        <stop offset="1" style="stop-color: var(--brand-primary)" />
      </linearGradient>
    </defs>
    <g fill={`url(#${gid})`}>
      <rect x="11" y="20" width="8" height="24" rx="1" />
      <rect x="21" y="5" width="9" height="39" rx="1" />
      <rect x="32" y="12" width="8" height="32" rx="1" />
      <rect x="42" y="22" width="7" height="22" rx="1" />
    </g>
    <g stroke="#fff" stroke-opacity=".45" stroke-width="1">
      <path d="M15 23v18M25.5 8v33M36 15v26M45.5 25v16" />
    </g>
    <path d="M3 47 30 30.5 57 47Z" fill="#fff" />
    <path d="M3 47 30 30.5 57 47" fill="none" style="stroke: var(--brand-primary-strong)" stroke-width="4.2" stroke-linejoin="miter" stroke-linecap="round" />
    <g style="fill: var(--brand-primary)">
      <rect x="27.4" y="38" width="2.3" height="2.3" />
      <rect x="30.3" y="38" width="2.3" height="2.3" />
      <rect x="27.4" y="40.9" width="2.3" height="2.3" />
      <rect x="30.3" y="40.9" width="2.3" height="2.3" />
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__name">BANGASH</span>
    <span class="logo__sub">Real Estate &amp; Builders</span>
  </span>
</a>
