---
/* Header logo — asal gold logo ka emblem (buildings + B + chhat) aur naam. */
import { Image } from 'astro:assets';
import { SITE } from '../config/site';
import mark from '../assets/brand/logo-mark.png';
interface Props { id?: string }
---

<a href="/" class="logo" aria-label={`${SITE.name} — Home`}>
  <Image src={mark} alt="" class="logo__mark logo__mark--img" width={96} height={96} loading="eager" />
  <span class="logo__text">
    <span class="logo__name">BANGASH</span>
    <span class="logo__sub">Real Estate &amp; Builders</span>
  </span>
</a>
