---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config/site';
import { AREAS } from '../data/areas';
import defaultOg from '../assets/images/hero-house.jpg';
import logoGold from '../assets/brand/logo-gold.jpg';

export interface SEOProps {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Extra page-specific JSON-LD objects */
  schema?: Record<string, unknown>[];
}

const { title, description = SITE.description, image = defaultOg, noindex = false, type = 'website', schema = [] } = Astro.props as SEOProps;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
// Google ~60-65 characters dikhata hai — lamba title ho to brand name nahi lagate
const withBrand = `${title} | ${SITE.titleName}`;
const fullTitle = title.includes(SITE.titleName) || withBrand.length > 65 ? title : withBrand;
const og = await getImage(
  typeof image === 'string'
    ? { src: image, inferSize: true, width: 1200, height: 630, format: 'jpg', fit: 'cover' }
    : { src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' },
);
const ogUrl = new URL(og.src, site).href;
const logoImg = await getImage({ src: logoGold, width: 512, height: 512, format: 'png' });
const logoUrl = new URL(logoImg.src, site).href;

// Business schema — Google ko batata hai ke ye real estate agency kahan aur kin areas mein kaam karti hai
const business = {
  '@context': 'https://schema.org',
  '@type': ['RealEstateAgent', 'GeneralContractor'],
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: logoUrl,
  alternateName: [SITE.titleName, 'Bangash real estate and builders'],
  slogan: SITE.motto,
  hasMap: SITE.mapsUrl,
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  image: ogUrl,
  description: SITE.description,
  telephone: SITE.phoneLink,
  email: SITE.email,
  priceRange: 'PKR',
  openingHours: SITE.hoursSchema,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  areaServed: [
    { '@type': 'City', name: 'Rawalpindi' },
    { '@type': 'City', name: 'Islamabad' },
    { '@type': 'Country', name: 'Pakistan' },
    ...AREAS.map((a) => ({ '@type': 'Place', name: `${a.name}, ${a.city}` })),
  ],
  sameAs: [SITE.mapsUrl, ...Object.values(SITE.socials).filter(Boolean)],
  knowsAbout: ['Real estate in Rawalpindi', 'Real estate in Islamabad', 'Houses for sale', 'Houses for rent', 'Flats for rent', 'Plots for sale', 'House construction'],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  publisher: { '@id': `${SITE.url}/#business` },
};

const allSchema = [business, website, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<!-- Local SEO -->
<meta name="geo.region" content="PK-PB" />
<meta name="geo.placename" content="Rawalpindi" />

<!-- Open Graph (Facebook, WhatsApp previews) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_PK" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
