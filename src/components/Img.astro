---
/* Local (ImageMetadata) aur Supabase (URL string) dono photos ke liye ek component.
   Remote photos bhi build par optimize (WebP, sahi size) ho jati hain. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, ...rest } = Astro.props;
---

{typeof src === 'string' ? <Image src={src} inferSize {...rest} /> : <Image src={src} {...rest} />}
