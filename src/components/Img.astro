---
/* One component for both local photos (ImageMetadata) and Supabase photos (URL string).
   Remote photos are optimized at build time too (WebP, correct sizes). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, ...rest } = Astro.props;
---

{typeof src === 'string' ? <Image src={src} inferSize {...rest} /> : <Image src={src} {...rest} />}
