---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class:list={[`icon-${name}`, className]}
  width={size}
  height={size}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  {...attrs}
  set:html={body}
/>
