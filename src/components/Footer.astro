---
import { Image } from 'astro:assets';
import logoGold from '../assets/brand/logo-gold.jpg';
import Icon from './Icon.astro';
import { SITE, whatsappLink, emailLink } from '../config/site';
import { SERVICES } from '../data/services';
import { AREAS } from '../data/areas';

const socials = Object.entries(SITE.socials).filter(([, url]) => url);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-logo" aria-label={SITE.name}>
          <Image src={logoGold} alt={`${SITE.name} logo`} width={168} height={168} />
          <span><strong>Bangash</strong><span>Real Estate &amp; Builders</span></span>
        </a>
        <p style="margin-top:18px;max-width:340px">
          Your trusted partner in real estate &amp; construction — buy, sell or rent houses, flats and plots in Rawalpindi &amp; Islamabad, or let us build your next home.
        </p>
        <p class="footer-motto">“{SITE.motto}”</p>
        {
          socials.length > 0 && (
            <div class="socials">
              {socials.map(([name, url]) => (
                <a href={url} target="_blank" rel="noopener" aria-label={name}>
                  <Icon name={name} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <h3>Services</h3>
        <ul class="footer-links">
          {SERVICES.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
          <li><a href="/properties/">All Properties</a></li>
        </ul>
      </div>

      <div>
        <h3>Explore</h3>
        <ul class="footer-links">
          <li><a href="/real-estate-rawalpindi/">Real Estate in Rawalpindi</a></li>
          <li><a href="/real-estate-islamabad/">Real Estate in Islamabad</a></li>
          <li><a href="/projects/">Our Projects</a></li>
          <li><a href="/guides/">Property Guides</a></li>
          <li><a href="/tools/marla-calculator/">Marla Calculator</a></li>
          <li><a href="/areas/">All Areas</a></li>
        </ul>
      </div>

      <div>
        <h3>Popular Areas</h3>
        <ul class="footer-links">
          {AREAS.slice(0, 6).map((a) => <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>)}
        </ul>
      </div>

      <div>
        <h3>Get in Touch</h3>
        <ul class="footer-links footer-contact">
          <li><Icon name="pin" /><a href={SITE.mapsUrl} target="_blank" rel="noopener">{SITE.address.street}, {SITE.address.city}</a></li>
          <li><Icon name="phone" /><a href={`tel:${SITE.phoneLink}`}>{SITE.phone}</a></li>
          <li><Icon name="whatsapp" /><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp Chat</a></li>
          <li><Icon name="mail" /><a href={emailLink()} style="word-break:break-all">{SITE.email}</a></li>
          <li><Icon name="clock" /><span>{SITE.hours}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/sitemap-index.xml">Sitemap</a></p>
    </div>
  </div>
</footer>

<a href={whatsappLink()} class="wa-float" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <Icon name="whatsapp" />
  <span class="wa-float__label">Chat on WhatsApp</span>
</a>
