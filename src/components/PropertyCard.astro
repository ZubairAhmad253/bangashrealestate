---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { SITE, MESSAGES, whatsappLink } from '../config/site';
import { getArea } from '../data/areas';
import { formatPrice, priceText, purposeLabel, typeLabel, type Property } from '../data/properties';

interface Props {
  property: Property;
  delay?: number;
  eager?: boolean;
}
const { property: p, delay = 0, eager = false } = Astro.props;
const area = getArea(p.area);
const url = `/properties/${p.slug}/`;
---

<article
  class="property-card"
  data-reveal="up"
  style={`--d:${delay}s`}
  data-purpose={p.purpose}
  data-price={p.showPrice === false || !p.price ? '' : String(p.price)}
  data-beds={p.beds ?? ''}
  data-type={p.type}
  data-area={p.area}
>
  <div class="property-card__media">
    <Img
      src={p.image}
      alt={`${p.title} ${purposeLabel[p.purpose].toLowerCase()} in ${p.location}`}
      widths={[400, 640, 900]}
      sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 380px"
      loading={eager ? 'eager' : 'lazy'}
    />
    <div class="property-card__badges">
      <span class:list={['badge', p.purpose === 'sale' ? 'badge--sale' : 'badge--rent']}>{purposeLabel[p.purpose]}</span>
      <span class="badge">{typeLabel[p.type]}</span>
      {p.hot && <span class="badge badge--hot">Hot</span>}
      {(p.videos?.length ?? 0) > 0 && <span class="badge badge--video"><Icon name="play" size={12} /> Video</span>}
    </div>
    <p class:list={['property-card__price', { 'property-card__price--ask': p.showPrice === false || !p.price }]}>
      {p.showPrice === false || !p.price ? 'Price on request' : <>PKR {formatPrice(p.price)}{p.purpose === 'rent' && <small> /month</small>}</>}
    </p>
  </div>
  <div class="property-card__body">
    <h3 class="property-card__title"><a href={url}>{p.title}</a></h3>
    <p class="property-card__loc"><Icon name="pin" />{p.location}{area && !p.location.includes(area.city) ? `, ${area.city.split(' /')[0]}` : ''}</p>
    <div class="specs">
      <span class="spec"><Icon name="area" />{p.size}</span>
      {p.beds && <span class="spec"><Icon name="bed" />{p.beds} Beds</span>}
      {p.baths && <span class="spec"><Icon name="bath" />{p.baths} Baths</span>}
      {p.type === 'plot' && <span class="spec"><Icon name="map" />Residential</span>}
    </div>
  </div>
  <a
    class="property-card__wa"
    href={whatsappLink(MESSAGES.property({ title: p.title, location: p.location, price: priceText(p), url: new URL(url, SITE.url).href }))}
    target="_blank"
    rel="noopener"
    aria-label={`Ask about ${p.title} on WhatsApp`}
  >
    <Icon name="whatsapp" />
  </a>
</article>
